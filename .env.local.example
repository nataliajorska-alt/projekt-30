# Skopiuj ten plik jako .env.local i uzupełnij wartościami z Firebase Console
# Instrukcja: patrz SETUP.md krok 3

NEXT_PUBLIC_FIREBASE_API_KEY=twoj-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=twoj-projekt.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=twoj-projekt
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=twoj-projekt.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Rejestracja nowych kont. Domyślnie wyłączona (apka jednoosobowa) — obcy nie
# założą konta. Ustaw na true TYLKO gdy zakładasz nowe konto, potem usuń/false.
NEXT_PUBLIC_ALLOW_REGISTRATION=false
